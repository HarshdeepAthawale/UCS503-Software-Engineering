// Thapar Nexus — Prisma schema (Phase 1: Identity & Profile).
// Conventions (docs/Rules.md): snake_case columns, plural tables, uuid PKs,
// created_at/updated_at/deleted_at on every table, soft delete (never hard-delete).
// Product rules are encoded as DB constraints wherever possible (docs/Schema.md §6).

generator client {
  provider = "prisma-client-js"
  // Windows-on-ARM64 has no native Prisma query engine (prisma/prisma#15306).
  // We use the pure-WASM query compiler + a JS `pg` driver adapter instead, so
  // there is NO native binary to load — architecture-independent. See src/lib/db.ts.
  // driverAdapters + queryCompiler are GA in 6.19 (auto-enabled with an adapter).
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase transaction pooler (6543)
  directUrl = env("DIRECT_URL") // Supabase session pooler (5432) for migrations
}

// ── Enumerations ─────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  FACULTY
  ALUMNI
  ADMIN
}

enum UserStatus {
  UNVERIFIED      // registered, OTP not yet confirmed
  ACTIVE          // verified, full access for their role
  PENDING_ALUMNI  // alumni claim submitted, read-only until approved
  SUSPENDED       // access revoked by admin
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillRequirement {
  REQUIRED
  PREFERRED
}

enum AlumniClaimDecision {
  APPROVED
  REJECTED
}

// ── Phase 2 (The Spine) — Opportunity pipeline enums (docs/Schema.md §4) ─────

enum OppType {
  RESEARCH
  INTERNSHIP
  TA
  HACKATHON_TEAM
  MICRO_TASK
  REFERRAL
}

enum OppStatus {
  DRAFT
  LIVE
  AT_RISK // SLA pledge breached (T-15)
  EXPIRED // deadline passed (T-10)
  CLOSED
}

enum SlaPledge {
  H24
  H48
  WEEK
}

enum AppState {
  APPLIED
  RECEIVED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum RejectionCode {
  SKILL_MISMATCH
  SEATS_FILLED
  TIMING_CONFLICT
  PROFILE_INCOMPLETE
  STRONGER_APPLICANTS
  OTHER
}

enum NotifFreq {
  IMMEDIATE
  DAILY
  WEEKLY
}

// ── Team formation (T-22; docs/PRD S6) ───────────────────────────────────────

enum TeamStatus {
  FORMING // still recruiting
  LOCKED  // every role slot filled
  CLOSED  // lead closed it early
}

enum TeamRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ── Meeting scheduling via Google Meet ───────────────────────────────────────

enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

// Moderation: why a posting was flagged, and where the flag stands (T-36, M9).
enum FlagReason {
  SPAM
  MISLEADING
  INAPPROPRIATE
  DUPLICATE
  OTHER
}

enum FlagStatus {
  OPEN      // awaiting admin review
  RESOLVED  // upheld (posting may have been removed)
  DISMISSED // reviewed, no violation
}

// ── Identity ─────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String     @map("password_hash")
  role         Role       @default(STUDENT)
  status       UserStatus @default(UNVERIFIED)
  name         String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile       Profile?
  refreshTokens RefreshToken[]
  otpChallenges OtpChallenge[]
  alumniClaim   AlumniClaim?
  auditEvents   AuditLog[]     @relation("actor")
  opportunities Opportunity[]  @relation("poster")
  applications  Application[]  @relation("student")
  flagsReported Flag[]         @relation("flag_reporter")
  events        ApplicationEvent[] @relation("event_actor")
  messagesSent  Message[]      @relation("message_sender")
  notifications Notification[] @relation("notification_user")
  notificationPref NotificationPreference? @relation("notification_pref")
  attestationsIssued Attestation[] @relation("attestation_issuer")
  teamsLed        Team[]            @relation("team_lead")
  teamMemberships TeamMember[]      @relation("team_member")
  teamJoinRequests TeamJoinRequest[] @relation("team_join_requester")
  googleCalendarCredential GoogleCalendarCredential?
  meetingsOrganized Meeting[] @relation("meeting_organizer")

  @@index([role])
  @@index([status])
  @@map("users")
}

// Refresh tokens act as the server-side session store (docs/TechSpec §6.1).
// Stored as a SHA-256 hash — never the raw token. `familyId` groups a rotation
// lineage so reuse of a revoked token can invalidate the whole family (theft
// detection, codeguard-0-session-management-and-cookies).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  // Session context fingerprint (hashed) for anomaly detection.
  uaHash    String?   @map("ua_hash")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// One-time passwords are stored hashed with a short TTL and an attempt counter
// (codeguard-0-authentication-mfa). Raw OTP is emailed, never persisted.
model OtpChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  purpose   String    // e.g. "REGISTER_VERIFY"
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_challenges")
}

// Alumni claim-and-approve flow (docs/PRD §4.5). Account stays PENDING_ALUMNI
// (read-only) until an admin approves.
model AlumniClaim {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @unique @map("user_id") @db.Uuid
  rollNo         String               @map("roll_no")
  gradYear       Int                  @map("grad_year")
  degree         String
  proofUrl       String               @map("proof_url")
  decision       AlumniClaimDecision?
  decisionReason String?              @map("decision_reason")
  reviewedById   String?              @map("reviewed_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([decision])
  @@map("alumni_claims")
}

// ── Profile ──────────────────────────────────────────────────────────────────

model Profile {
  userId     String  @id @map("user_id") @db.Uuid
  branch     String?
  year       Int?
  // CGPA is private by default (docs/PRD NFR-PR1); `cgpaPublic` gates exposure.
  cgpa       Decimal? @db.Decimal(3, 2)
  cgpaPublic Boolean  @default(false) @map("cgpa_public")
  // Active/current backlogs (self-reported). Not privacy-gated like `cgpa` -
  // treated the same as `branch`/`year` (docs/PRD M3 eligibility filters).
  backlogs   Int?
  bio        String?

  // One-line self-description ("Security researcher · binary exploitation").
  // `role` is the ACCOUNT type (STUDENT/FACULTY/...), which says nothing about
  // what a person actually works on - this is the field a reviewer reads first.
  headline String?

  // External identity links. Stored raw and rendered as anchors, so the schema
  // layer restricts them to http(s) (codeguard-0-xss).
  githubUrl   String? @map("github_url")
  linkedinUrl String? @map("linkedin_url")
  websiteUrl  String? @map("website_url")

  // What the member is open to, drawn from the SAME vocabulary as postings, so
  // this is matchable later rather than free text. Empty list = not stated.
  openTo       OppType[] @default([]) @map("open_to")
  hoursPerWeek Int?      @map("hours_per_week")

  // Résumé metadata (T-44, M2). The PDF itself lives in Supabase Storage at
  // `resumeKey`; only its filename/size/timestamp are kept here. Null → no résumé.
  resumeKey        String?   @map("resume_key")
  resumeName       String?   @map("resume_name")
  resumeSize       Int?      @map("resume_size")
  resumeUploadedAt DateTime? @map("resume_uploaded_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSkills UserSkill[]
  projects   ProfileProject[]

  @@map("profiles")
}

// Portfolio projects with repository links (docs/PRD M2). Structured, owner-
// managed, soft-deleted so history survives. The repo link is the anchor that
// S7 (verified project artifacts) later verifies — kept optional here so a
// non-code project can still be listed.
model ProfileProject {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  repoUrl     String?   @map("repo_url")
  liveUrl     String?   @map("live_url")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("profile_projects")
}

// Admin-curated skill taxonomy (docs/PRD M2) — skills are NOT free text.
// Soft-deleted (`deletedAt`) rather than hard-deleted so user_skills history and
// analytics stay intact (docs/Rules.md: nothing hard-deleted).
model Skill {
  id     String @id @default(uuid()) @db.Uuid
  name   String @unique
  domain String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  userSkills UserSkill[]
  opportunitySkills OpportunitySkill[]
  attestations Attestation[]
  teamRoleSkills TeamRoleSkill[]

  @@index([domain])
  @@index([deletedAt])
  @@map("skills")
}

model UserSkill {
  userId      String      @map("user_id") @db.Uuid
  skillId     String      @map("skill_id") @db.Uuid
  proficiency Proficiency

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // Composite PK prevents duplicate skill rows (docs/Schema.md §6, constraint 6).
  @@id([userId, skillId])
  @@map("user_skills")
}

// ── Opportunity (T-09; docs/Schema.md §5.5) ──────────────────────────────────

// Structured posting with typed fields, an SLA pledge and auto-expiry.
// `seats_filled` can never exceed `seat_count` (constraint 4, docs/Schema.md §6).
model Opportunity {
  id         String    @id @default(uuid()) @db.Uuid
  posterId   String    @map("poster_id") @db.Uuid
  type       OppType
  title      String
  description String
  domain     String
  duration   String?
  stipend    Boolean   @default(false)
  stipendAmount Decimal? @map("stipend_amount") @db.Decimal(10, 2)
  seatCount  Int       @default(1) @map("seat_count")
  seatsFilled Int      @default(0) @map("seats_filled")
  deadline   DateTime  @db.Timestamptz(6)
  slaPledge  SlaPledge @map("sla_pledge")
  status     OppStatus @default(LIVE)

  // Eligibility filters (docs/PRD M3). Drawn from the fixed vocabulary in
  // src/lib/domain/branch.ts; empty array = every branch eligible. `minCgpa`
  // null = no CGPA floor. Enforced server-side in application.service.ts
  // (authoritative) and mirrored client-side to hide "Apply" for a student who
  // can't meet it.
  eligibleBranches String[] @default([]) @map("eligible_branches")
  minCgpa          Decimal? @db.Decimal(3, 2) @map("min_cgpa")
  // Max ACTIVE backlogs a student may have to apply; null = no backlog cap.
  maxBacklogs      Int?     @map("max_backlogs")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  poster            User                @relation("poster", fields: [posterId], references: [id], onDelete: Cascade)
  opportunitySkills OpportunitySkill[]
  applications      Application[]
  flags             Flag[]

  @@index([posterId])
  @@index([status])
  @@index([deadline])
  @@index([type, domain, stipend])
  @@map("opportunities")
}

// Required/preferred skill tags for an opportunity (admin-curated taxonomy).
model OpportunitySkill {
  opportunityId String          @map("opportunity_id") @db.Uuid
  skillId       String          @map("skill_id") @db.Uuid
  requirement   SkillRequirement

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([opportunityId, skillId])
  @@map("opportunity_skills")
}

// ── Application pipeline (T-12/T-13; docs/Schema.md §5.6) ─────────────────────

// One application per student per opportunity (unique index on non-deleted
// rows, constraint 3). `first_transition_at` is stamped once and drives TTA.
model Application {
  id               String    @id @default(uuid()) @db.Uuid
  opportunityId    String    @map("opportunity_id") @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  status           AppState  @default(APPLIED)
  appliedAt        DateTime  @default(now()) @map("applied_at") @db.Timestamptz(6)
  firstTransitionAt DateTime? @map("first_transition_at") @db.Timestamptz(6)
  rejectionCode    RejectionCode? @map("rejection_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     User        @relation("student", fields: [studentId], references: [id], onDelete: Cascade)
  events      ApplicationEvent[]
  thread      MessageThread?
  attestations Attestation[]
  meetings    Meeting[]

  @@index([opportunityId])
  @@index([studentId])
  @@index([studentId, status]) // budget count (T-12)
  // NOTE: a PARTIAL unique index on (opportunity_id, student_id) WHERE deleted_at
  // IS NULL enforces "one active application per student per opportunity". Prisma
  // cannot express a partial unique, so it lives in the migration
  // 20260828130000_application_constraints (constraint 3, docs/Schema §6).
  @@map("applications")
}

// INSERT-ONLY append log (constraint 2) — the basis of trustworthy TTA.
model ApplicationEvent {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  fromState     AppState? @map("from_state")
  toState       AppState @map("to_state")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User        @relation("event_actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_events")
}

// ── Attestations (T-19; docs/PRD S1, docs/Schema.md §6 constraint 1) ─────────

// A skill endorsement anchored to a completed engagement — "unfarmable"
// because it requires a real SELECTED application to exist between the
// issuer and the student. That requirement is enforced by a Postgres
// CONSTRAINT TRIGGER (see migration 20260906000000_attestations), not just the
// service layer: a plain CHECK can't reference another table, and a composite
// FK to a redundant (application_id, status) column would also block a later
// legitimate transition away from SELECTED (e.g. withdrawing an offer), so a
// trigger that only gates the moment of insertion is the correct mechanism.
model Attestation {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  skillId       String   @map("skill_id") @db.Uuid
  issuerId      String   @map("issuer_id") @db.Uuid
  // Free-text description of the engagement, e.g. "NLP research assistant,
  // Aug-Nov 2026" (docs/MasterPlan.md S1).
  context       String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  issuer      User        @relation("attestation_issuer", fields: [issuerId], references: [id], onDelete: Cascade)

  // One attestation per skill per engagement - a poster can attest multiple
  // skills for the same SELECTED application, but not duplicate the same one.
  @@unique([applicationId, skillId])
  @@index([skillId])
  @@map("attestations")
}

// ── Team formation for hackathons (T-22; docs/PRD S6) ────────────────────────

// Peer-driven, distinct from the faculty/alumni-gated Opportunity pipeline: any
// STUDENT may lead a team. A team declares role slots with skill tags; students
// request a slot, the lead accepts/rejects, and the team locks once every role
// is full. The Jaccard "complementarity" scoring the spec describes is
// deliberately deferred past v1 (S6 depends on S5, also unbuilt) - this ships
// the core request/accept/lock flow first.
model Team {
  id          String     @id @default(uuid()) @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  name        String
  hackathon   String
  description String?
  eventDate   DateTime?  @map("event_date") @db.Timestamptz(6)
  status      TeamStatus @default(FORMING)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  lead    User         @relation("team_lead", fields: [leadId], references: [id], onDelete: Cascade)
  roles   TeamRole[]
  members TeamMember[]
  meetings Meeting[]

  @@index([leadId])
  @@index([status])
  @@map("teams")
}

// Required/preferred-style slot: `slotsFilled` can never exceed `slotCount`
// (constraint mirrors `opportunities.seats_filled <= seat_count`).
model TeamRole {
  id          String @id @default(uuid()) @db.Uuid
  teamId      String @map("team_id") @db.Uuid
  label       String
  slotCount   Int    @map("slot_count")
  slotsFilled Int    @default(0) @map("slots_filled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  skills   TeamRoleSkill[]
  requests TeamJoinRequest[]
  members  TeamMember[]

  @@index([teamId])
  @@map("team_roles")
}

// Skill tags for a role (admin-curated taxonomy, same as OpportunitySkill).
model TeamRoleSkill {
  teamRoleId String @map("team_role_id") @db.Uuid
  skillId    String @map("skill_id") @db.Uuid

  teamRole TeamRole @relation(fields: [teamRoleId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([teamRoleId, skillId])
  @@map("team_role_skills")
}

// A student's request to fill one role slot. One PENDING/ACCEPTED request per
// (role, student) - `@@unique` blocks duplicate spam requests to the same slot.
model TeamJoinRequest {
  id            String             @id @default(uuid()) @db.Uuid
  teamRoleId    String             @map("team_role_id") @db.Uuid
  studentId     String             @map("student_id") @db.Uuid
  message       String?
  status        TeamRequestStatus  @default(PENDING)
  // Reuses the Application pipeline's rejection-code vocabulary (e.g.
  // SEATS_FILLED) rather than inventing a parallel enum for the same idea.
  rejectionCode RejectionCode?     @map("rejection_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teamRole TeamRole @relation(fields: [teamRoleId], references: [id], onDelete: Cascade)
  student  User     @relation("team_join_requester", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teamRoleId, studentId])
  @@index([studentId])
  @@map("team_join_requests")
}

// A confirmed member, filling one specific role slot on one team.
model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  roleId   String   @map("role_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  team Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User     @relation("team_member", fields: [userId], references: [id], onDelete: Cascade)
  role TeamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

// ── Meeting scheduling via Google Meet ────────────────────────────────────────

// One row per user who has granted the calendar.events scope (incremental
// OAuth consent, separate from sign-in). The refresh token is encrypted at
// rest (AES-256-GCM, key from TOKEN_ENCRYPTION_KEY - see google-calendar.ts);
// only the person SCHEDULING a meeting needs this - attendees are added by
// email on the organizer's own calendar event and never need their own grant.
model GoogleCalendarCredential {
  userId                String    @id @map("user_id") @db.Uuid
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  googleEmail           String    @map("google_email")
  scope                 String
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_credentials")
}

// A scheduled meeting belongs to EXACTLY ONE of an application (interview) or
// a team (team sync) - enforced by a CHECK in a follow-up migration (Prisma
// has no `num_nonnulls` equivalent in its schema DSL).
model Meeting {
  id              String        @id @default(uuid()) @db.Uuid
  organizerId     String        @map("organizer_id") @db.Uuid
  applicationId   String?       @map("application_id") @db.Uuid
  teamId          String?       @map("team_id") @db.Uuid
  title           String
  scheduledAt     DateTime      @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int           @default(30) @map("duration_minutes")
  googleEventId   String        @map("google_event_id")
  meetLink        String        @map("meet_link")
  status          MeetingStatus @default(SCHEDULED)
  // Dedup marker for the reminder cron (mirrors deadline-reminder's approach).
  remindedAt      DateTime?     @map("reminded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizer   User         @relation("meeting_organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([scheduledAt])
  @@map("meetings")
}

// ── Governance: faculty roster (Identity v2) ─────────────────────────────────

// Emails that should hold the FACULTY role. On any login, a STUDENT whose email
// is listed here is promoted to FACULTY (admin-curated). Lets the operator load
// the finite professor roster before deployment. See docs/Identity-and-Admin-Plan.md.
model FacultyAllowlist {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.Citext
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("faculty_allowlist")
}

// ── Scoped messaging (T-16; docs/PRD M7) ─────────────────────────────────────

// A thread is bound 1:1 to an application. Only that application's student and
// its opportunity's poster (or an admin) may read/post — messaging cannot be
// used to cold-contact anyone outside an active application context.
model MessageThread {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @unique @map("application_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@map("message_threads")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("message_sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("messages")
}

// ── Notifications (T-17; docs/PRD M8) ────────────────────────────────────────

// In-app notification feed. `deliveredAt` is stamped when a notification is
// rolled into a digest, so the digest job never re-delivers the same item.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  payload     Json      @default("{}")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("notification_user", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([deliveredAt])
  @@map("notifications")
}

// One row per user; the digest cadence they prefer.
model NotificationPreference {
  userId       String    @id @map("user_id") @db.Uuid
  frequency    NotifFreq @default(DAILY)
  lastDigestAt DateTime? @map("last_digest_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("notification_pref", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ── Moderation: flag queue (T-36; docs/PRD M9) ───────────────────────────────

// A report against a posting. Any non-admin member may raise one; an admin
// reviews the queue and either upholds it (RESOLVED, optionally removing the
// posting) or DISMISSES it. `reviewedById` is a bare column (like AlumniClaim),
// not a relation. A PARTIAL UNIQUE index on (opportunity_id, reporter_id) WHERE
// status = 'OPEN' — added in the migration, since Prisma cannot express it —
// stops one member opening duplicate flags on the same posting.
model Flag {
  id             String     @id @default(uuid()) @db.Uuid
  opportunityId  String     @map("opportunity_id") @db.Uuid
  reporterId     String     @map("reporter_id") @db.Uuid
  reason         FlagReason
  detail         String?
  status         FlagStatus @default(OPEN)
  resolutionNote String?    @map("resolution_note")
  reviewedById   String?    @map("reviewed_by_id") @db.Uuid
  resolvedAt     DateTime?  @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reporter    User        @relation("flag_reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([opportunityId])
  @@map("flags")
}

// ── Governance ───────────────────────────────────────────────────────────────

// Append-only audit trail for privileged/security-relevant actions
// (docs/TechSpec §7). No UPDATE/DELETE at the application layer.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  target    String?
  // Non-PII context only (codeguard-0-logging): rationale codes, ids, ip hash.
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}

# ─────────────────────────────────────────────────────────────────────────────
# Thapar Nexus — environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (see .gitignore).
# Secrets must be long, random, and unique per environment (codeguard-1-hardcoded-credentials).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon / Railway / local).
DATABASE_URL="postgresql://user:password@localhost:5432/thapar_nexus?schema=public"

# JWT signing secrets — generate with: openssl rand -base64 48
# Access and refresh MUST use different secrets so one cannot forge the other.
JWT_ACCESS_SECRET="change-me-min-32-bytes-random-access"
JWT_REFRESH_SECRET="change-me-min-32-bytes-random-refresh"

# Token lifetimes.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# Institutional identity policy.
ALLOWED_EMAIL_DOMAIN="thapar.edu"

# Product limits (admin-tunable in later phases).
APPLICATION_BUDGET="10"

# OTP policy.
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"

# Auth rate limits (per identifier, per window).
AUTH_RATE_LIMIT_MAX="10"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"

# Shared secret for scheduled-job endpoints (/api/cron/*): expiry (T-10), SLA
# nudge (T-15), deadline reminders (T-35), notification digest (T-17).
# Generate: openssl rand -base64 24
#
# The schedules are NOT in this repo. They live in cron-job.org, which calls
# each endpoint hourly with `Authorization: Bearer $CRON_SECRET`. They used to
# be declared in vercel.json, which silently did nothing for the whole time the
# app was hosted on Render — an external trigger cannot drift from the host
# again. Vercel Cron is not used: Hobby allows two daily jobs and we need four
# hourly. See docs/Remaining-Work-Plan.md §A.
#
# When unset, every /api/cron/* endpoint returns 404 (fail-closed — never open).
CRON_SECRET=""

# Canonical public origin of THIS deployment — no trailing slash.
# Google matches the redirect_uri byte for byte, and without a configured origin
# it would be read from the Host header, which a request can spoof.
#   local   → (blank) — the request origin is used
#   Vercel  → (blank) — VERCEL_PROJECT_PRODUCTION_URL is injected automatically
#   else    → https://your-domain.example.edu  (REQUIRED in production)
# Set it explicitly if you attach a custom domain Vercel does not serve as the
# project's production URL.
APP_ORIGIN=""

# Outbound email (Resend) — OTP verification and passwordless sign-in codes.
# Without BOTH of these the mailer refuses to send in production and logs the
# message in dev; the OTP flow then completes in the UI but no mail arrives.
#   1. Verify a domain you control at resend.com/domains (add its DNS records).
#   2. EMAIL_FROM must be an address on that verified domain.
# Alumni sign in ONLY by OTP, so this is required before any pilot.
RESEND_API_KEY=""
EMAIL_FROM="Thapar Nexus <nexus@your-domain.example>"

# Google OAuth ("Sign in with Google"). Create a Web application OAuth client in
# Google Cloud Console; register origin http://localhost:3000 and redirect URI
# http://localhost:3000/api/auth/google/callback. In production register
# ${APP_ORIGIN} and ${APP_ORIGIN}/api/auth/google/callback as well. Leave blank
# to disable the feature (routes 404, button hidden). Restricted to the
# institutional domain — see ALLOWED_EMAIL_DOMAIN.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Read at BUILD time and inlined into the client bundle — set it in the hosting
# provider's env BEFORE the build, or the button stays hidden in the deploy.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# ── Supabase Storage — résumé PDFs (T-44, M2) ────────────────────────────────
# Setup (once): in the Supabase dashboard → Storage, create a PRIVATE bucket
# named "resumes" (leave "Public" OFF). Then Project Settings → API: copy the
# Project URL into SUPABASE_URL and the **service_role** key into
# SUPABASE_SERVICE_ROLE_KEY. The service_role key is SERVER-ONLY — never prefix
# it with NEXT_PUBLIC and never expose it to the browser; it is used only to
# upload and to mint short-lived signed URLs for the private bucket.
# Leave both blank to disable résumé upload/preview (routes report it cleanly).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional — the bucket name; defaults to "resumes" when unset.
SUPABASE_RESUME_BUCKET="resumes"

# Node environment: development | test | production
NODE_ENV="development"

# When true, allows non-HTTPS cookies for local dev only. Must be false in prod
# — `next build` forces NODE_ENV=production and env.ts refuses to boot with it
# on, so the hosting provider's environment must set this false (or omit it).
ALLOW_INSECURE_COOKIES="true"

# ── Admin bootstrap (used once by `npm run bootstrap:admin`) ──────────────────
# The ONLY account the system provisions. No mock data is ever seeded.
# Provide REAL credentials; the script refuses defaults and short passwords.
ADMIN_EMAIL="admin@thapar.edu"
ADMIN_PASSWORD=""

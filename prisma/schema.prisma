// Thapar Nexus — Prisma schema (Phase 1: Identity & Profile).
// Conventions (docs/Rules.md): snake_case columns, plural tables, uuid PKs,
// created_at/updated_at/deleted_at on every table, soft delete (never hard-delete).
// Product rules are encoded as DB constraints wherever possible (docs/Schema.md §6).

generator client {
  provider = "prisma-client-js"
  // Windows-on-ARM64 has no native Prisma query engine (prisma/prisma#15306).
  // We use the pure-WASM query compiler + a JS `pg` driver adapter instead, so
  // there is NO native binary to load — architecture-independent. See src/lib/db.ts.
  // driverAdapters + queryCompiler are GA in 6.19 (auto-enabled with an adapter).
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase transaction pooler (6543)
  directUrl = env("DIRECT_URL") // Supabase session pooler (5432) for migrations
}

// ── Enumerations ─────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  FACULTY
  ALUMNI
  ADMIN
}

enum UserStatus {
  UNVERIFIED      // registered, OTP not yet confirmed
  ACTIVE          // verified, full access for their role
  PENDING_ALUMNI  // alumni claim submitted, read-only until approved
  SUSPENDED       // access revoked by admin
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillRequirement {
  REQUIRED
  PREFERRED
}

enum AlumniClaimDecision {
  APPROVED
  REJECTED
}

// ── Phase 2 (The Spine) — Opportunity pipeline enums (docs/Schema.md §4) ─────

enum OppType {
  RESEARCH
  INTERNSHIP
  TA
  HACKATHON_TEAM
  MICRO_TASK
  REFERRAL
}

enum OppStatus {
  DRAFT
  LIVE
  AT_RISK // SLA pledge breached (T-15)
  EXPIRED // deadline passed (T-10)
  CLOSED
}

enum SlaPledge {
  H24
  H48
  WEEK
}

enum AppState {
  APPLIED
  RECEIVED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum RejectionCode {
  SKILL_MISMATCH
  SEATS_FILLED
  TIMING_CONFLICT
  PROFILE_INCOMPLETE
  STRONGER_APPLICANTS
  OTHER
}

enum NotifFreq {
  IMMEDIATE
  DAILY
  WEEKLY
}

// ── Identity ─────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String     @map("password_hash")
  role         Role       @default(STUDENT)
  status       UserStatus @default(UNVERIFIED)
  name         String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile       Profile?
  refreshTokens RefreshToken[]
  otpChallenges OtpChallenge[]
  alumniClaim   AlumniClaim?
  auditEvents   AuditLog[]     @relation("actor")
  opportunities Opportunity[]  @relation("poster")
  applications  Application[]  @relation("student")
  events        ApplicationEvent[] @relation("event_actor")
  messagesSent  Message[]      @relation("message_sender")
  notifications Notification[] @relation("notification_user")
  notificationPref NotificationPreference? @relation("notification_pref")

  @@index([role])
  @@index([status])
  @@map("users")
}

// Refresh tokens act as the server-side session store (docs/TechSpec §6.1).
// Stored as a SHA-256 hash — never the raw token. `familyId` groups a rotation
// lineage so reuse of a revoked token can invalidate the whole family (theft
// detection, codeguard-0-session-management-and-cookies).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  // Session context fingerprint (hashed) for anomaly detection.
  uaHash    String?   @map("ua_hash")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// One-time passwords are stored hashed with a short TTL and an attempt counter
// (codeguard-0-authentication-mfa). Raw OTP is emailed, never persisted.
model OtpChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  purpose   String    // e.g. "REGISTER_VERIFY"
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_challenges")
}

// Alumni claim-and-approve flow (docs/PRD §4.5). Account stays PENDING_ALUMNI
// (read-only) until an admin approves.
model AlumniClaim {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @unique @map("user_id") @db.Uuid
  rollNo         String               @map("roll_no")
  gradYear       Int                  @map("grad_year")
  degree         String
  proofUrl       String               @map("proof_url")
  decision       AlumniClaimDecision?
  decisionReason String?              @map("decision_reason")
  reviewedById   String?              @map("reviewed_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([decision])
  @@map("alumni_claims")
}

// ── Profile ──────────────────────────────────────────────────────────────────

model Profile {
  userId     String  @id @map("user_id") @db.Uuid
  branch     String?
  year       Int?
  // CGPA is private by default (docs/PRD NFR-PR1); `cgpaPublic` gates exposure.
  cgpa       Decimal? @db.Decimal(3, 2)
  cgpaPublic Boolean  @default(false) @map("cgpa_public")
  bio        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSkills UserSkill[]

  @@map("profiles")
}

// Admin-curated skill taxonomy (docs/PRD M2) — skills are NOT free text.
// Soft-deleted (`deletedAt`) rather than hard-deleted so user_skills history and
// analytics stay intact (docs/Rules.md: nothing hard-deleted).
model Skill {
  id     String @id @default(uuid()) @db.Uuid
  name   String @unique
  domain String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  userSkills UserSkill[]
  opportunitySkills OpportunitySkill[]

  @@index([domain])
  @@index([deletedAt])
  @@map("skills")
}

model UserSkill {
  userId      String      @map("user_id") @db.Uuid
  skillId     String      @map("skill_id") @db.Uuid
  proficiency Proficiency

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // Composite PK prevents duplicate skill rows (docs/Schema.md §6, constraint 6).
  @@id([userId, skillId])
  @@map("user_skills")
}

// ── Opportunity (T-09; docs/Schema.md §5.5) ──────────────────────────────────

// Structured posting with typed fields, an SLA pledge and auto-expiry.
// `seats_filled` can never exceed `seat_count` (constraint 4, docs/Schema.md §6).
model Opportunity {
  id         String    @id @default(uuid()) @db.Uuid
  posterId   String    @map("poster_id") @db.Uuid
  type       OppType
  title      String
  description String
  domain     String
  duration   String?
  stipend    Boolean   @default(false)
  seatCount  Int       @default(1) @map("seat_count")
  seatsFilled Int      @default(0) @map("seats_filled")
  deadline   DateTime  @db.Timestamptz(6)
  slaPledge  SlaPledge @map("sla_pledge")
  status     OppStatus @default(LIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  poster            User                @relation("poster", fields: [posterId], references: [id], onDelete: Cascade)
  opportunitySkills OpportunitySkill[]
  applications      Application[]

  @@index([posterId])
  @@index([status])
  @@index([deadline])
  @@index([type, domain, stipend])
  @@map("opportunities")
}

// Required/preferred skill tags for an opportunity (admin-curated taxonomy).
model OpportunitySkill {
  opportunityId String          @map("opportunity_id") @db.Uuid
  skillId       String          @map("skill_id") @db.Uuid
  requirement   SkillRequirement

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([opportunityId, skillId])
  @@map("opportunity_skills")
}

// ── Application pipeline (T-12/T-13; docs/Schema.md §5.6) ─────────────────────

// One application per student per opportunity (unique index on non-deleted
// rows, constraint 3). `first_transition_at` is stamped once and drives TTA.
model Application {
  id               String    @id @default(uuid()) @db.Uuid
  opportunityId    String    @map("opportunity_id") @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  status           AppState  @default(APPLIED)
  appliedAt        DateTime  @default(now()) @map("applied_at") @db.Timestamptz(6)
  firstTransitionAt DateTime? @map("first_transition_at") @db.Timestamptz(6)
  rejectionCode    RejectionCode? @map("rejection_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     User        @relation("student", fields: [studentId], references: [id], onDelete: Cascade)
  events      ApplicationEvent[]
  thread      MessageThread?

  @@index([opportunityId])
  @@index([studentId])
  @@index([studentId, status]) // budget count (T-12)
  // NOTE: a PARTIAL unique index on (opportunity_id, student_id) WHERE deleted_at
  // IS NULL enforces "one active application per student per opportunity". Prisma
  // cannot express a partial unique, so it lives in the migration
  // 20260828130000_application_constraints (constraint 3, docs/Schema §6).
  @@map("applications")
}

// INSERT-ONLY append log (constraint 2) — the basis of trustworthy TTA.
model ApplicationEvent {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  fromState     AppState? @map("from_state")
  toState       AppState @map("to_state")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User        @relation("event_actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_events")
}

// ── Governance: faculty roster (Identity v2) ─────────────────────────────────

// Emails that should hold the FACULTY role. On any login, a STUDENT whose email
// is listed here is promoted to FACULTY (admin-curated). Lets the operator load
// the finite professor roster before deployment. See docs/Identity-and-Admin-Plan.md.
model FacultyAllowlist {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.Citext
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("faculty_allowlist")
}

// ── Scoped messaging (T-16; docs/PRD M7) ─────────────────────────────────────

// A thread is bound 1:1 to an application. Only that application's student and
// its opportunity's poster (or an admin) may read/post — messaging cannot be
// used to cold-contact anyone outside an active application context.
model MessageThread {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @unique @map("application_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@map("message_threads")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("message_sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("messages")
}

// ── Notifications (T-17; docs/PRD M8) ────────────────────────────────────────

// In-app notification feed. `deliveredAt` is stamped when a notification is
// rolled into a digest, so the digest job never re-delivers the same item.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  payload     Json      @default("{}")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("notification_user", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([deliveredAt])
  @@map("notifications")
}

// One row per user; the digest cadence they prefer.
model NotificationPreference {
  userId       String    @id @map("user_id") @db.Uuid
  frequency    NotifFreq @default(DAILY)
  lastDigestAt DateTime? @map("last_digest_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("notification_pref", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ── Governance ───────────────────────────────────────────────────────────────

// Append-only audit trail for privileged/security-relevant actions
// (docs/TechSpec §7). No UPDATE/DELETE at the application layer.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  target    String?
  // Non-PII context only (codeguard-0-logging): rationale codes, ids, ip hash.
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}

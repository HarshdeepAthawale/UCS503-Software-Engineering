{
  "name": "thapar-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "A verified opportunity pipeline for the institute. Phase 1: identity & IAM foundation.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "postinstall": "prisma generate",
    "build": "prisma generate && node scripts/next-production.mjs build",
    "start": "node scripts/next-production.mjs start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate:apply": "node --env-file=.env scripts/apply-migrations.mjs",
    "db:migrate:deploy": "node scripts/apply-migrations.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "bootstrap:admin": "node --env-file=.env --import tsx prisma/bootstrap-admin.ts",
    "provision:student": "node --env-file=.env --import tsx prisma/provision-student.ts",
    "provision:faculty": "node --env-file=.env --import tsx prisma/provision-faculty.ts",
    "provision:faculty:dev": "node --env-file=.env.development.local --import tsx prisma/provision-faculty.ts",
    "purge:test-data": "node --env-file=.env scripts/purge-test-data.mjs",
    "purge:test-data:dev": "node --env-file=.env.development.local scripts/purge-test-data.mjs",
    "db:studio": "prisma studio",
    "link:cursor-skills": "node scripts/link-cursor-skills.mjs",
    "google:uris": "node --env-file=.env scripts/google-oauth-uris.mjs",
    "docker:up": "docker compose up --build",
    "demo:setup": "node --env-file=.env --env-file=.env.demo.local scripts/demo-setup.mjs",
    "dev:demo": "node --env-file=.env --env-file=.env.demo.local scripts/dev-demo.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^6.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "jose": "^5.9.6",
    "next": "^15.1.4",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11.0 <25"
  }
}
